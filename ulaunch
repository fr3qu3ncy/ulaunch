#!/usr/bin/env bash
# ulaunch — daily entry point: server + kiosk browser, clean shutdown
set -euo pipefail
cd "$(dirname "$0")"

PORT="${ULAUNCH_PORT:-8317}"
RUN_DIR="${ULAUNCH_RUN_DIR:-$HOME/.ulaunch/run}"
mkdir -p "$RUN_DIR"

[ -d .venv ] || { echo "Not installed — run ./install.sh first"; exit 1; }
[ -f backend/static/index.html ] || { echo "Frontend build missing — run ./install.sh"; exit 1; }

BROWSER="${ULAUNCH_BROWSER:-}"
if [ -z "$BROWSER" ]; then
  for c in chromium chromium-browser google-chrome google-chrome-stable; do
    if command -v "$c" >/dev/null 2>&1; then BROWSER="$c"; break; fi
  done
fi
[ -n "$BROWSER" ] || {
  echo "No Chromium/Chrome found. Install one:  sudo apt install chromium"
  exit 1
}

# clear stale pid files
rm -f "$RUN_DIR/server.pid" "$RUN_DIR/browser.pid"

# 1. backend server
ULAUNCH_PORT="$PORT" ULAUNCH_RUN_DIR="$RUN_DIR" \
  ./.venv/bin/python backend/main.py &
SERVER_PID=$!
echo "$SERVER_PID" > "$RUN_DIR/server.pid"

cleanup() {
  [ -n "${BROWSER_PID:-}" ] && kill "$BROWSER_PID" 2>/dev/null || true
  kill "$SERVER_PID" 2>/dev/null || true
  wait 2>/dev/null || true
  rm -f "$RUN_DIR/server.pid" "$RUN_DIR/browser.pid"
}
trap 'exit 0' SIGINT SIGTERM
trap cleanup EXIT

# 2. wait for server health
for _ in $(seq 1 50); do
  if curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then break; fi
  sleep 0.2
done
curl -sf "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1 || {
  echo "✗ server did not start on 127.0.0.1:$PORT"
  exit 1
}

# 3. kiosk browser
"$BROWSER" \
  --kiosk \
  --app="http://127.0.0.1:$PORT" \
  --no-first-run \
  --no-default-browser-check \
  --disable-extensions \
  --disable-sync \
  --disable-session-crashed-bubble \
  --disable-background-timer-throttling \
  --window-size=1280,720 &
BROWSER_PID=$!
echo "$BROWSER_PID" > "$RUN_DIR/browser.pid"

# 4. wait: browser exiting (user chose Back-to-Desktop/Exit) ends the session
wait "$BROWSER_PID" 2>/dev/null || true
exit 0
